{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Enterprise Alert Agent: Run with uv",
      "type": "shell",
      "command": "uv",
      "args": [
        "run",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}/examples/enterprise_alert_agent"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
