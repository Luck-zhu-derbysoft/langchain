.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- 版本控制 ----
.git/
.gitignore
.gitattributes

# ---- 文档与脚本（运行时不需要）----
docs/
scripts/dev_experiments/
tests/
*.md
!README.md

# ---- CI / 构建元数据 ----
.github/
Dockerfile
.dockerignore
