# Copy this file to .env and fill in real values. Do NOT commit .env to version control.

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- DashScope / LLM (required) ----
DASHSCOPE_API_KEY=
MODEL_NAME=qwen-plus
FALLBACK_MODEL_NAME=qwen-turbo
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- LangSmith (optional) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-alert-agent
LANGSMITH_TRACING=true

# ---- MySQL (required only when MYSQL_HOST is configured) ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=agent
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- Redis (required) ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- PostgreSQL (required) ----
PG_HOST=
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=
PG_SSL_MODE=prefer

# ---- MCP (required if mcp_enabled=true) ----
MCP_SERVICE_URL=
MCP_ENABLED=true
MCP_API_KEY=

# ---- JWT / Admin (required) — use at least 32 random characters ----
ADMIN_JWT_SECRET=
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXP_MINUTES=120
# 轮换时填入上一把密钥，待旧 token 过期后清空（见 ADMIN_JWT_EXP_MINUTES）
ADMIN_JWT_SECRET_PREVIOUS=
# 本地开发用的原始 API Key，仅供脚本/文档拼请求体使用，服务端只保存其 sha256 哈希
DEV_ADMIN_API_KEY=
# user_id -> {api_key_hash, role, tenant_id} 主体表（JSON），服务端据此签发角色/租户
ADMIN_PRINCIPALS=

# ---- Resilience ----
MODEL_RETRY_BACKOFF_SECONDS=0.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ---- Observability ----
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
