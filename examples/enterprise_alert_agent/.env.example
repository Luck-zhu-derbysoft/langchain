# Copy this file to .env and fill in real values. Do NOT commit .env to version control.

# ---- App ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- DashScope / LLM (required) ----
DASHSCOPE_API_KEY=
MODEL_NAME=qwen-plus
FALLBACK_MODEL_NAME=qwen-turbo
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- LangSmith (optional) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-alert-agent
LANGSMITH_TRACING=true

# ---- MySQL (required) ----
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DB=agent
MYSQL_USER=root
MYSQL_PASSWORD=

# ---- Redis (required) ----
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- PostgreSQL (required) ----
PG_HOST=
PG_PORT=5432
PG_DB=postgres
PG_USER=postgres
PG_PASSWORD=
PG_SSL_MODE=prefer

# ---- MCP (required if mcp_enabled=true) ----
MCP_SERVICE_URL=
MCP_ENABLED=true
MCP_API_KEY=

# ---- JWT / Admin (required) — use at least 32 random characters ----
ADMIN_JWT_SECRET=
ADMIN_JWT_ALGORITHM=HS256
ADMIN_JWT_EXP_MINUTES=120
ADMIN_API_KEY=

# ---- Resilience ----
MODEL_RETRY_BACKOFF_SECONDS=0.5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

# ---- Observability ----
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=5
